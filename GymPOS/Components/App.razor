<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="GymPOS.styles.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        function downloadFile(base64, fileName) {
            const link = document.createElement('a');
            link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,' + base64;
            link.download = fileName;
            link.click();
        }
    </script>

    <script>
        window.registerHotkeys = (dotnetRef) => {
            document.addEventListener('keydown', function(e) {
                if (e.key === 'F2') {
                    e.preventDefault();
                    dotnetRef.invokeMethodAsync('OnF2');
                }
                if (e.key === 'F3') {
                    e.preventDefault();
                    dotnetRef.invokeMethodAsync('OnF3');
                }
                if (e.key === 'Escape') {
                    dotnetRef.invokeMethodAsync('OnEscape');
                }
            });
        };

        window.focusScanner = () => {
            const input = document.getElementById('inputScanner');
            if (input) input.focus();
        };
    </script>
</body>
</html>