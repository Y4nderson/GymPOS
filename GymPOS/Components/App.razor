<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="GymPOS.styles.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script>
        function downloadFile(base64, fileName) {
            const link = document.createElement('a');
            link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,' + base64;
            link.download = fileName;
            link.click();
        }
    </script>

    <script>
        window.registerHotkeys = (dotnetRef) => {
            document.addEventListener('keydown', function(e) {
                if (e.key === 'F2') {
                    e.preventDefault();
                    dotnetRef.invokeMethodAsync('OnF2');
                }
                if (e.key === 'F3') {
                    e.preventDefault();
                    dotnetRef.invokeMethodAsync('OnF3');
                }
                if (e.key === 'Escape') {
                    dotnetRef.invokeMethodAsync('OnEscape');
                }
            });
        };

        window.focusScanner = () => {
            const input = document.getElementById('inputScanner');
            if (input) input.focus();
        };

                window.focusScanner = () => {
            const input = document.getElementById('inputScanner');
            if (input) input.focus();
        };
        window.focusEntradaScanner = () => {
            const input = document.getElementById('inputScannerEntrada');
            if (input) input.focus();
        };
    </script>

    <script>
        const charts = {};

        window.renderBarChart = (id, labels, data, label, color) => {
            if (charts[id]) charts[id].destroy();
            const ctx = document.getElementById(id);
            if (!ctx) return;
            charts[id] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: data,
                        backgroundColor: color + '33',
                        borderColor: color,
                        borderWidth: 2,
                        borderRadius: 8,
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#fbd5d5' },
                            ticks: { color: '#6b7280' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#6b7280', font: { size: 11 } }
                        }
                    }
                }
            });
        };

        window.renderDonutChart = (id, labels, data) => {
            if (charts[id]) charts[id].destroy();
            const ctx = document.getElementById(id);
            if (!ctx) return;
            charts[id] = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: ['#E31E24', '#10b981', '#3b82f6'],
                        borderWidth: 0,
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#6b7280', font: { size: 11 } }
                        }
                    }
                }
            });
        };
    </script>



</body>
</html>