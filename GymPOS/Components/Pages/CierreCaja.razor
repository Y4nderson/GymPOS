@page "/caja"
@using GymPOS.Models
@using GymPOS.Services
@inject CajaService CajaService
@inject ConteoService ConteoService
@inject ReporteService ReporteService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer

@if (!cajaAbierta)
{
    <div class="card p-4 mt-4" style="max-width:450px;margin:auto">
        <div class="text-center mb-3">
            <h4>💰 Inicio de Caja</h4>
            <p class="text-muted">Debe abrir la caja antes de operar.</p>
        </div>
        <div class="mb-2">
            <label>Responsable</label>
            <input class="form-control" @bind="descripcionApertura" placeholder="Nombre del responsable" />
        </div>
        <div class="mb-3">
            <label>Monto Inicial (₡)</label>
            <input type="number" class="form-control fs-4" @bind="montoInicial" />
        </div>
        <button class="btn btn-success w-100" @onclick="AbrirCaja" disabled="@abriendo">
            @if (abriendo)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Abriendo...</span>
            }
            else
            {
                <span>✅ Abrir Caja</span>
            }
        </button>
    </div>
}
else
{
    <h3>Estado de Caja</h3>

    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card text-center p-3 border-success">
                <h6>💵 Efectivo</h6>
                <h4 class="text-success">₡@totalEfectivo.ToString("N0")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 border-primary">
                <h6>📱 SINPE Móvil</h6>
                <h4 class="text-primary">₡@totalSinpe.ToString("N0")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 border-warning">
                <h6>💳 Tarjeta</h6>
                <h4 class="text-warning">₡@totalTarjeta.ToString("N0")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 border-dark">
                <h6>🏦 Total General</h6>
                <h4>₡@totalGeneral.ToString("N0")</h4>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "resumen" ? "active" : "")"
                    @onclick='() => tabActiva = "resumen"'>
                Resumen
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "movimientos" ? "active" : "")"
                    @onclick='() => tabActiva = "movimientos"'>
                Movimientos
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "egresos" ? "active" : "")"
                    @onclick='() => tabActiva = "egresos"'>
                Egresos
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "corte" ? "active" : "")"
                    @onclick='() => tabActiva = "corte"'>
                Corte de Turno
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "cierre" ? "active" : "")"
                    @onclick='() => tabActiva = "cierre"'>
                Cierre del Día
            </button>
        </li>
    </ul>

    @if (tabActiva == "resumen")
    {
        <div class="card p-3">
            <h5>Resumen del Día</h5>
            <table class="table">
                <tbody>
                    <tr>
                        <td>Monto Inicial</td>
                        <td class="text-end">₡@montoInicialCaja.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Ventas Efectivo</td>
                        <td class="text-end text-success">₡@ventasEfectivo.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Ventas SINPE</td>
                        <td class="text-end text-primary">₡@totalSinpe.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Ventas Tarjeta</td>
                        <td class="text-end text-warning">₡@totalTarjeta.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Egresos</td>
                        <td class="text-end text-danger">-₡@totalEgresos.ToString("N0")</td>
                    </tr>
                    <tr class="fw-bold" style="background:#fff5f5; border-top: 2px solid #e5e7eb;">
                        <td style="color:#1a1a2e;">Total Ventas del Día</td>
                        <td class="text-end" style="color:#E31E24;">₡@totalVentas.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    @if (tabActiva == "movimientos")
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Hora</th>
                    <th>Tipo</th>
                    <th>Descripción</th>
                    <th>Método</th>
                    <th class="text-end">Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in movimientos)
                {
                    <tr>
                        <td>@m.Fecha.ToString("hh:mm tt")</td>
                        <td>@m.Tipo</td>
                        <td>@m.Descripcion</td>
                        <td>@m.MetodoPago</td>
                        <td class="text-end @(m.Monto >= 0 ? "text-success" : "text-danger")">
                            ₡@m.Monto.ToString("N0")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (tabActiva == "egresos")
    {
        <div class="card p-3 mb-3">
            <h5>Agregar Egreso</h5>
            <div class="mb-2">
                <label>Descripción</label>
                <input class="form-control" @bind="egresoDescripcion" placeholder="Ej: Pago proveedor" />
            </div>
            <div class="mb-2">
                <label>Monto (₡)</label>
                <input type="number" class="form-control" @bind="egresoMonto" />
            </div>
            <button class="btn btn-warning" @onclick="AgregarEgreso" disabled="@guardandoEgreso">
                @if (guardandoEgreso)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Agregar Egreso</span>
                }
            </button>
        </div>

        <h6>Egresos del día:</h6>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Hora</th>
                    <th>Descripción</th>
                    <th class="text-end">Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in movimientos.Where(m => m.Tipo == "Egreso"))
                {
                    <tr>
                        <td>@m.Fecha.ToString("hh:mm tt")</td>
                        <td>@m.Descripcion</td>
                        <td class="text-end text-danger">₡@Math.Abs(m.Monto).ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (tabActiva == "corte")
    {
        <div class="card p-3" style="max-width:500px">
            <h5>✂️ Registrar Corte de Turno</h5>
            <p class="text-muted small">El corte registra el estado actual sin cerrar la caja. Puedes seguir operando normalmente.</p>

            <div class="mb-2">
                <label>Turno</label>
                <select class="form-control" @bind="turnoCorte">
                    <option>Mediodía</option>
                    <option>Tarde</option>
                </select>
            </div>

            <table class="table table-sm mb-3">
                <tbody>
                    <tr>
                        <td>Ventas Efectivo</td>
                        <td class="text-end text-success">₡@ventasEfectivo.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Ventas SINPE</td>
                        <td class="text-end text-primary">₡@totalSinpe.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Ventas Tarjeta</td>
                        <td class="text-end text-warning">₡@totalTarjeta.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Ventas Conteo Físico</td>
                        <td class="text-end text-info">₡@totalVentasPorConteo.ToString("N0")</td>
                    </tr>
                    <tr class="fw-bold">
                        <td>Efectivo Esperado en Caja</td>
                        <td class="text-end">₡@totalEfectivo.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>

            <div class="mb-2">
                <label>Efectivo Físico Contado (₡)</label>
                <input type="number" class="form-control fs-4" @bind="montoCorte" />
            </div>

            @if (montoCorte > 0)
            {
                var diff = montoCorte - totalEfectivo;
                <div class="alert @(diff == 0 ? "alert-success" : diff > 0 ? "alert-warning" : "alert-danger") text-center mt-2">
                    @if (diff == 0)
                    {
                        <span>✅ Todo cuadra perfectamente</span>
                    }
                    else if (diff > 0)
                    {
                        <span>⬆️ Sobran ₡@diff.ToString("N0")</span>
                    }
                    else
                    {
                        <span>⬇️ Faltan ₡@Math.Abs(diff).ToString("N0")</span>
                    }
                </div>
            }

            <button class="btn btn-primary w-100 mt-2" @onclick="RegistrarCorte" disabled="@guardandoCorte">
                @if (guardandoCorte)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Registrando...</span>
                }
                else
                {
                    <span>✂️ Registrar Corte @turnoCorte</span>
                }
            </button>
        </div>

        @if (cortesDelDia.Any())
        {
            <h6 class="mt-4">Cortes registrados hoy:</h6>
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Hora</th>
                        <th>Descripción</th>
                        <th class="text-end">Monto Contado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in cortesDelDia)
                    {
                        <tr>
                            <td>@c.Fecha.ToString("hh:mm tt")</td>
                            <td>@c.Descripcion</td>
                            <td class="text-end">₡@c.Monto.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (tabActiva == "cierre")
    {
        @if (cajaCerradaDefinitivamente)
        {
            <div class="alert alert-info text-center">
                ✅ La caja fue cerrada definitivamente hoy.
            </div>
        }
        else
        {
            <div class="card p-3" style="max-width:500px">
                <h5>🔒 Cierre Definitivo del Día</h5>
                <p class="text-muted small">Esta acción cierra la caja del día. Mañana se deberá hacer una nueva apertura.</p>

                <table class="table table-sm mb-3">
                    <tbody>
                        <tr>
                            <td>Monto Inicial</td>
                            <td class="text-end fw-bold">₡@montoInicialCaja.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>Ventas Efectivo</td>
                            <td class="text-end text-success">₡@ventasEfectivo.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>Ventas SINPE</td>
                            <td class="text-end text-primary">₡@totalSinpe.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>Ventas Tarjeta</td>
                            <td class="text-end text-warning">₡@totalTarjeta.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>Ventas por Conteo Físico</td>
                            <td class="text-end text-info">₡@totalVentasPorConteo.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>Egresos</td>
                            <td class="text-end text-danger">-₡@totalEgresos.ToString("N0")</td>
                        </tr>
                        <tr class="fw-bold">
                            <td>Efectivo Esperado en Caja</td>
                            <td class="text-end">₡@totalEfectivo.ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>

                <div class="mb-2">
                    <label>Efectivo Físico Contado (₡)</label>
                    <input type="number" class="form-control fs-4" @bind="montoFinal" />
                </div>

                @if (montoFinal > 0)
                {
                    var diff = montoFinal - totalEfectivo;
                    <div class="alert @(diff == 0 ? "alert-success" : diff > 0 ? "alert-warning" : "alert-danger") text-center fs-5 mt-2">
                        @if (diff == 0)
                        {
                            <span>✅ Todo cuadra perfectamente</span>
                        }
                        else if (diff > 0)
                        {
                            <span>⬆️ Sobran ₡@diff.ToString("N0")</span>
                        }
                        else
                        {
                            <span>⬇️ Faltan ₡@Math.Abs(diff).ToString("N0")</span>
                        }
                    </div>
                }

                <button class="btn btn-danger w-100 mt-2" @onclick="CerrarCaja" disabled="@cerrando">
                    @if (cerrando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Cerrando caja...</span>
                    }
                    else
                    {
                        <span>🔒 Cerrar Caja Definitivamente</span>
                    }
                </button>
            </div>
        }
    }
}

@if (mensaje != null)
{
    <div class="alert alert-success mt-3 text-center">✅ @mensaje</div>
}

@code {
    private bool cajaAbierta = false;
    private bool cajaCerradaDefinitivamente = false;
    private string descripcionApertura = string.Empty;
    private decimal montoInicial = 0;
    private decimal montoFinal = 0;
    private decimal montoCorte = 0;
    private decimal montoInicialCaja = 0;
    private decimal totalEfectivo = 0;
    private decimal totalSinpe = 0;
    private decimal totalTarjeta = 0;
    private decimal totalGeneral = 0;
    private decimal totalVentas = 0;
    private decimal ventasEfectivo = 0;
    private decimal totalEgresos = 0;
    private decimal totalVentasPorConteo = 0;
    private List<MovimientoCaja> movimientos = new();
    private List<MovimientoCaja> cortesDelDia = new();
    private string egresoDescripcion = string.Empty;
    private decimal egresoMonto = 0;
    private string? mensaje;
    private string tabActiva = "resumen";
    private string turnoCorte = "Mediodía";

    // Flags anti-doble click
    private bool abriendo = false;
    private bool guardandoEgreso = false;
    private bool guardandoCorte = false;
    private bool cerrando = false;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cajaAbierta = await CajaService.CajaAbiertaHoyAsync();
        cajaCerradaDefinitivamente = await CajaService.CajaCerradaDefinitivamenteHoyAsync();

        if (cajaAbierta)
        {
            movimientos = await CajaService.GetMovimientosHoyAsync();
            totalVentas = await CajaService.GetTotalVentasHoyAsync();
            montoInicialCaja = movimientos.FirstOrDefault(m => m.Tipo == "Apertura")?.Monto ?? 0;
            ventasEfectivo = await CajaService.GetTotalPorMetodoAsync("Efectivo");
            totalSinpe = await CajaService.GetTotalPorMetodoAsync("SINPE Móvil");
            totalTarjeta = await CajaService.GetTotalPorMetodoAsync("Tarjeta");
            totalEgresos = await CajaService.GetTotalEgresosHoyAsync();
            totalEfectivo = montoInicialCaja + ventasEfectivo - totalEgresos;
            totalGeneral = totalEfectivo + totalSinpe + totalTarjeta;
            totalVentasPorConteo = await ConteoService.GetTotalVentasPorConteoAsync();
            cortesDelDia = movimientos.Where(m => m.Tipo == "Corte").ToList();
        }
    }

    private async Task AbrirCaja()
    {
        if (abriendo || string.IsNullOrWhiteSpace(descripcionApertura)) return;
        abriendo = true;
        await CajaService.AbrirCajaAsync(montoInicial, descripcionApertura);
        Navigation.NavigateTo("/caja", forceLoad: true);
    }

    private async Task AgregarEgreso()
    {
        if (guardandoEgreso || string.IsNullOrWhiteSpace(egresoDescripcion) || egresoMonto <= 0) return;
        guardandoEgreso = true;
        try
        {
            await CajaService.AgregarEgresoAsync(egresoDescripcion, egresoMonto);
            egresoDescripcion = string.Empty;
            egresoMonto = 0;
            mensaje = "Egreso registrado.";
            await Cargar();
            await Task.Delay(3000);
            mensaje = null;
        }
        finally { guardandoEgreso = false; }
    }

    private async Task RegistrarCorte()
    {
        if (guardandoCorte) return;
        guardandoCorte = true;
        try
        {
            await CajaService.RegistrarCorteAsync(turnoCorte, montoCorte);
            montoCorte = 0;
            mensaje = $"✂️ Corte de {turnoCorte} registrado. La caja sigue abierta.";
            await Cargar();
            await Task.Delay(3000);
            mensaje = null;
        }
        finally { guardandoCorte = false; }
    }

    private async Task CerrarCaja()
    {
        if (cerrando) return;
        cerrando = true;
        try
        {
            await CajaService.CerrarCajaAsync(montoFinal);
            var bytes = await ReporteService.GenerarReporteTurnoExcelAsync();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Reporte_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFile", base64, fileName);
            mensaje = "🔒 Caja cerrada definitivamente. Reporte descargado.";
            await Cargar();
            await Task.Delay(3000);
            mensaje = null;
        }
        finally { cerrando = false; }
    }
}