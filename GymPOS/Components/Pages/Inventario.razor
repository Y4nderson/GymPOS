@page "/inventario"
@using GymPOS.Models
@using GymPOS.Services
@inject InventarioService InventarioService
@inject ConteoService ConteoService
@inject CajaService CajaService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@if (!cajaAbierta)
{
    <div style="max-width:450px;margin:5rem auto;">
        <div class="card p-4 text-center">
            <div style="font-size:3rem;margin-bottom:1rem;">🔒</div>
            <h4>Caja no abierta</h4>
            <p class="text-muted">Debe abrir la caja antes de realizar operaciones.</p>
            <button class="btn btn-primary mt-2" @onclick='() => Navigation.NavigateTo("/caja")'>
                Ir a Abrir Caja
            </button>
        </div>
    </div>
}
else
{
    <h3>📦 Inventario</h3>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "stock" ? "active" : "")"
                    @onclick='() => tabActiva = "stock"'>
                Stock Actual
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "conteo" ? "active" : "")"
                    @onclick='() => tabActiva = "conteo"'>
                Conteo Físico
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == "ajuste" ? "active" : "")"
                    @onclick='() => tabActiva = "ajuste"'>
                Ajuste Manual
            </button>
        </li>
    </ul>

    @if (tabActiva == "stock")
    {
        @if (productosBajoStock != null && productosBajoStock.Any())
        {
            <div class="alert alert-warning mb-3">
                ⚠️ <strong>@productosBajoStock.Count producto(s) con stock bajo:</strong>
                @string.Join(", ", productosBajoStock.Select(p => p.Nombre))
            </div>
        }

        <!-- Buscador -->
        <div style="position:relative;max-width:400px;margin-bottom:1rem;">
            <input class="form-control ps-3"
                   placeholder="Buscar producto..."
                   @bind="busqueda" @bind:event="oninput" />
        </div>

        <div class="card" style="overflow:hidden;">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Stock Actual</th>
                        <th>Stock Mínimo</th>
                        <th>Estado</th>
                        <th>Cambiar Mínimo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (productos != null)
                    {
                        @foreach (var p in productosFiltradosPaginados)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:600;">@p.Nombre</div>
                                    <div style="font-size:0.75rem;color:#9ca3af;">@p.Tipo · @p.Marca</div>
                                </td>
                                <td>
                                    <span class="badge @(p.Stock <= p.StockMinimo ? "bg-danger" : "bg-success")">
                                        @p.Stock unid.
                                    </span>
                                </td>
                                <td>@p.StockMinimo</td>
                                <td>
                                    @if (p.Stock == 0)
                                    {
                                        <span style="color:#E31E24;font-size:0.8rem;font-weight:600;">🚨 Sin stock</span>
                                    }
                                    else if (p.Stock <= p.StockMinimo)
                                    {
                                        <span style="color:#d97706;font-size:0.8rem;font-weight:600;">⚠️ Stock bajo</span>
                                    }
                                    else
                                    {
                                        <span style="color:#10b981;font-size:0.8rem;font-weight:600;">✅ OK</span>
                                    }
                                </td>
                                <td style="width:180px">
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control"
                                               value="@p.StockMinimo"
                                               @onchange="(e) => CambiarStockMinimo(p, e)" />
                                        <span class="input-group-text">mín</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        @if (totalPaginas > 1)
        {
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;">
                <div style="font-size:0.85rem;color:#6b7280;">
                    Mostrando @((paginaActual - 1) * itemsPorPagina + 1) - @Math.Min(paginaActual * itemsPorPagina, productosFiltrados.Count) de @productosFiltrados.Count productos
                </div>
                <div style="display:flex;gap:6px;">
                    <button class="btn btn-sm btn-secondary" @onclick="() => CambiarPagina(paginaActual - 1)"
                            disabled="@(paginaActual == 1)">
                        ←
                    </button>
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        var pagina = i;
                        <button class="btn btn-sm @(pagina == paginaActual ? "btn-primary" : "btn-secondary")"
                                @onclick="() => CambiarPagina(pagina)">
                            @pagina
                        </button>
                    }
                    <button class="btn btn-sm btn-secondary" @onclick="() => CambiarPagina(paginaActual + 1)"
                            disabled="@(paginaActual == totalPaginas)">
                        →
                    </button>
                </div>
            </div>
        }
    }

    @if (tabActiva == "conteo")
    {
        <div class="mb-3">
            <label>Tipo de conteo</label>
            <select class="form-control" style="max-width:200px" @bind="tipoConteo">
                <option>Mañana</option>
                <option>Mediodía</option>
                <option>Tarde</option>
                <option>Noche</option>
            </select>
        </div>

        @if (tipoConteo == "Mañana")
        {
            <div class="alert alert-info">
                📋 Conteo matutino — solo registra el inventario inicial del día. No genera corte ni modifica el stock del sistema.
            </div>
        }
        else if (tipoConteo == "Mediodía" || tipoConteo == "Tarde")
        {
            <div class="alert alert-warning">
                💰 Conteo con corte — registra inventario y muestra cuánto se vendió en el turno. Recuerda hacer el corte en Caja.
            </div>
        }
        else if (tipoConteo == "Noche")
        {
            <div class="alert alert-danger">
                🔒 Cierre definitivo — registra inventario final del día. Ve a Caja para hacer el cierre definitivo.
            </div>
        }

        <p class="text-muted small mb-3">ℹ️ El conteo físico no modifica el stock del sistema. Es solo para auditoría y control.</p>

        <!-- Buscador conteo -->
        <div style="max-width:400px;margin-bottom:1rem;">
            <input class="form-control ps-3"
                   placeholder="Buscar producto en conteo..."
                   @bind="busquedaConteo" @bind:event="oninput" />
        </div>

        <div class="card" style="overflow:hidden;">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Stock Sistema</th>
                        <th>Conteo Físico</th>
                        <th>Diferencia</th>
                        @if (tipoConteo != "Mañana")
                        {
                            <th>Total ₡ Vendido</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in itemsConteoFiltrados)
                    {
                        var diff = item.CantidadContada - item.Producto.Stock;
                        var totalVendido = Math.Abs(diff < 0 ? diff : 0) * item.Producto.Precio;
                        <tr>
                            <td>
                                <div style="font-weight:600;">@item.Producto.Nombre</div>
                                <div style="font-size:0.75rem;color:#9ca3af;">@item.Producto.Tipo · @item.Producto.Marca</div>
                            </td>
                            <td>
                                <span class="badge bg-success">@item.Producto.Stock</span>
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm"
                                       style="width:90px"
                                       @bind="item.CantidadContada" />
                            </td>
                            <td>
                                <span style="font-weight:700;color:@(diff == 0 ? "#10b981" : diff < 0 ? "#E31E24" : "#d97706");">
                                    @(diff > 0 ? "+" : "")@diff
                                </span>
                            </td>
                            @if (tipoConteo != "Mañana")
                            {
                                <td style="font-weight:600;color:#E31E24;">₡@totalVendido.ToString("N0")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (tipoConteo != "Mañana")
        {
            <div class="card p-3 mt-3" style="max-width:300px;border-left:4px solid #E31E24 !important;">
                <div style="font-size:0.75rem;text-transform:uppercase;color:#9ca3af;font-weight:600;">Total vendido por conteo</div>
                <div style="font-size:1.8rem;font-weight:700;color:#E31E24;font-family:'Outfit',sans-serif;">
                    ₡@itemsConteo.Sum(i => Math.Abs(Math.Min(i.CantidadContada - i.Producto.Stock, 0)) * i.Producto.Precio).ToString("N0")
                </div>
            </div>
        }

        <button class="btn btn-primary mt-3" @onclick="GuardarConteo" disabled="@guardandoConteo">
            @if (guardandoConteo)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Guardando...</span>
            }
            else
            {
                <span>💾 Guardar Conteo</span>
            }
        </button>

        @if (conteosGuardados.Any())
        {
            <h5 class="mt-4">Conteos del día:</h5>
            @foreach (var turno in new[] { "Mañana", "Mediodía", "Tarde", "Noche" })
            {
                var conteosDelTurno = conteosGuardados.Where(c => c.Turno == turno).ToList();
                @if (conteosDelTurno.Any())
                {
                    var horaConteo = conteosDelTurno.First().Fecha.ToString("hh:mm tt");
                    var colorBorde = turno == "Mañana" ? "#3b82f6" :
                                     turno == "Mediodía" ? "#f59e0b" :
                                     turno == "Tarde" ? "#E31E24" : "#6b7280";
                    var icono = turno == "Mañana" ? "📋" : turno == "Mediodía" ? "☀️" : turno == "Tarde" ? "🌤️" : "🌙";

                    <div class="card mb-3" style="border-left:4px solid @colorBorde !important;">
                        <div class="card-header fw-bold" style="border-left:none;">
                            @icono Conteo @turno — @horaConteo
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Sistema</th>
                                        <th>Físico</th>
                                        <th>Diferencia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in conteosDelTurno.GroupBy(c => c.ProductoId).Select(g => g.Last()))
                                    {
                                        <tr>
                                            <td>@c.Producto?.Nombre</td>
                                            <td>@c.CantidadSistema</td>
                                            <td>@c.CantidadContada</td>
                                            <td style="font-weight:700;color:@(c.Diferencia == 0 ? "#10b981" : "#E31E24");">
                                                @(c.Diferencia > 0 ? "+" : "")@c.Diferencia
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        }
    }

    @if (tabActiva == "ajuste")
    {
        <div class="card p-4" style="max-width:500px">
            <h5>⚠️ Ajuste Manual de Stock</h5>
            <p class="text-muted small">Solo para correcciones de errores. Todos los ajustes quedan registrados.</p>

            <div class="mb-2">
                <label>Producto</label>
                <select class="form-control" @bind="ajusteProductoId">
                    <option value="0">-- Seleccione --</option>
                    @foreach (var p in productos ?? new())
                    {
                        <option value="@p.Id">@p.Nombre (Stock: @p.Stock)</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label>Cantidad (positivo suma, negativo resta)</label>
                <input type="number" class="form-control" @bind="ajusteCantidad" />
            </div>
            <div class="mb-3">
                <label>Motivo <span class="text-danger">*</span></label>
                <input class="form-control" @bind="ajusteMotivo"
                       placeholder="Ej: Producto dañado, Error de conteo..." />
            </div>
            <button class="btn btn-warning w-100" @onclick="AjustarStock" disabled="@guardandoAjuste">
                @if (guardandoAjuste)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Aplicando...</span>
                }
                else
                {
                    <span>⚡ Aplicar Ajuste</span>
                }
            </button>
        </div>
    }
}

@if (mensaje != null)
{
    <div style="position:fixed;bottom:2rem;right:2rem;z-index:9999;">
        <div class="alert alert-success" style="box-shadow:0 4px 20px rgba(0,0,0,0.15);border-radius:12px;padding:1rem 1.5rem;">
            ✅ @mensaje
        </div>
    </div>
}

@code {
    private List<Producto>? productos;
    private List<Producto>? productosBajoStock;
    private List<ItemConteo> itemsConteo = new();
    private List<ConteoFisico> conteosGuardados = new();
    private string tabActiva = "stock";
    private string tipoConteo = "Mañana";
    private string? mensaje;
    private bool cajaAbierta = false;
    private bool guardandoConteo = false;
    private bool guardandoAjuste = false;
    private string busqueda = string.Empty;
    private string busquedaConteo = string.Empty;
    private int paginaActual = 1;
    private int itemsPorPagina = 10;

    private int ajusteProductoId = 0;
    private int ajusteCantidad = 0;
    private string ajusteMotivo = string.Empty;

    public class ItemConteo
    {
        public Producto Producto { get; set; } = new();
        public int CantidadContada { get; set; }
    }

    private List<Producto> productosFiltrados => productos == null ? new() :
        productos.Where(p =>
            string.IsNullOrEmpty(busqueda) ||
            p.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
            p.Marca.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
            p.Tipo.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
        ).ToList();

    private List<Producto> productosFiltradosPaginados => productosFiltrados
        .Skip((paginaActual - 1) * itemsPorPagina)
        .Take(itemsPorPagina)
        .ToList();

    private int totalPaginas => (int)Math.Ceiling(productosFiltrados.Count / (double)itemsPorPagina);

    private List<ItemConteo> itemsConteoFiltrados => string.IsNullOrEmpty(busquedaConteo)
        ? itemsConteo
        : itemsConteo.Where(i =>
            i.Producto.Nombre.Contains(busquedaConteo, StringComparison.OrdinalIgnoreCase) ||
            i.Producto.Marca.Contains(busquedaConteo, StringComparison.OrdinalIgnoreCase)
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        cajaAbierta = await CajaService.CajaAbiertaHoyAsync();
        if (cajaAbierta)
            await Cargar();
    }

    private async Task Cargar()
    {
        productos = await InventarioService.GetProductosAsync();
        productosBajoStock = await InventarioService.GetProductosBajoStockAsync();
        itemsConteo = productos.Select(p => new ItemConteo
        {
            Producto = p,
            CantidadContada = p.Stock
        }).ToList();
        conteosGuardados = await ConteoService.GetConteosDelTurnoAsync();
    }

    private void CambiarPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= totalPaginas)
            paginaActual = pagina;
    }

    private async Task CambiarStockMinimo(Producto p, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevoMinimo))
        {
            await InventarioService.ActualizarStockMinimoAsync(p.Id, nuevoMinimo);
            await Cargar();
        }
    }

    private async Task GuardarConteo()
    {
        if (guardandoConteo) return;
        guardandoConteo = true;
        try
        {
            var lista = itemsConteo.Select(c => new ConteoFisico
            {
                ProductoId = c.Producto.Id,
                CantidadContada = c.CantidadContada,
                CantidadSistema = c.Producto.Stock
            }).ToList();

            await ConteoService.GuardarConteoAsync(lista, tipoConteo);
            conteosGuardados = await ConteoService.GetConteosDelTurnoAsync();

            mensaje = tipoConteo == "Mañana" ? "✅ Conteo matutino guardado." :
                      tipoConteo == "Noche" ? "🔒 Conteo de cierre guardado. Ve a Caja para cerrar." :
                      $"✅ Conteo de {tipoConteo} guardado. Recuerda hacer el corte en Caja.";

            await Task.Delay(4000);
            mensaje = null;
        }
        finally { guardandoConteo = false; }
    }

    private async Task AjustarStock()
    {
        if (guardandoAjuste) return;
        if (ajusteProductoId == 0 || ajusteCantidad == 0 || string.IsNullOrWhiteSpace(ajusteMotivo))
        {
            mensaje = "⚠️ Complete todos los campos incluyendo el motivo.";
            return;
        }

        guardandoAjuste = true;
        try
        {
            await InventarioService.AjustarStockAsync(ajusteProductoId, ajusteCantidad, ajusteMotivo);
            ajusteProductoId = 0;
            ajusteCantidad = 0;
            ajusteMotivo = string.Empty;
            mensaje = "✅ Ajuste aplicado correctamente.";
            await Cargar();
            await Task.Delay(3000);
            mensaje = null;
        }
        finally { guardandoAjuste = false; }
    }
}