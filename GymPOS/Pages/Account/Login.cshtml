@page "/account/logout"
@model GymPOS.Pages.Account.LogoutModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inline Gym — Login</title>
    <link rel="stylesheet" href="/bootstrap/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
            padding: 1rem;
        }

        .login-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.12);
            overflow: hidden;
        }

        .login-header {
            background: #1a1a1a;
            padding: 2.5rem 2rem 2rem;
            text-align: center;
            position: relative;
        }

            .login-header::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #b01519, #E31E24, #ff6b6b);
            }

        .logo-icon {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #b01519, #E31E24);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 1rem;
            box-shadow: 0 4px 20px rgba(227,30,36,0.4);
        }

        .brand-name {
            font-family: 'Outfit', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: white;
            letter-spacing: 0.02em;
        }

        .brand-sub {
            font-size: 0.75rem;
            color: #E31E24;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            font-weight: 500;
        }

        .login-body {
            padding: 2rem;
        }

            .login-body h5 {
                font-family: 'Outfit', sans-serif;
                font-weight: 700;
                font-size: 1.2rem;
                color: #1a1a2e;
                margin-bottom: 0.25rem;
            }

            .login-body p {
                color: #9ca3af;
                font-size: 0.9rem;
                margin-bottom: 1.5rem;
            }

        .form-label {
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: #6b7280;
            margin-bottom: 0.4rem;
        }

        .form-control {
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .form-control:focus {
                border-color: #E31E24;
                box-shadow: 0 0 0 3px rgba(227,30,36,0.1);
                outline: none;
            }

        .btn-login {
            background: linear-gradient(135deg, #b01519, #E31E24);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.85rem;
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 0.03em;
            width: 100%;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 14px rgba(227,30,36,0.25);
        }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(227,30,36,0.35);
            }

        .alert-error {
            background: #fff5f5;
            border: 1px solid #fca5a5;
            color: #991b1b;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .login-footer {
            text-align: center;
            padding: 1rem 2rem 1.5rem;
            font-size: 0.75rem;
            color: #d1d5db;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-header">
                <div class="logo-icon">💪</div>
                <div class="brand-name">In Line</div>
                <div class="brand-sub">Sistema POS</div>
            </div>
            <div class="login-body">
                <h5>Iniciar Sesión</h5>
                <p>Ingresa tus credenciales para continuar</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert-error">⚠️ @Model.ErrorMessage</div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Correo Electrónico</label>
                        <input type="email" name="Email" class="form-control"
                               placeholder="correo@ejemplo.com"
                               value="@Model.Email" required autofocus />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Contraseña</label>
                        <input type="password" name="Password" class="form-control"
                               placeholder="••••••••" required />
                    </div>
                    <button type="submit" class="btn-login">Ingresar al Sistema</button>
                </form>
            </div>
            <div class="login-footer">
                Gimnasio In Line &copy; @DateTime.Now.Year
            </div>
        </div>
    </div>
</body>
</html>